#!/usr/bin/env sh
set -eu

# Secret scan staged changes before commit.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it first:"
  echo "https://github.com/gitleaks/gitleaks#installing"
  exit 1
fi

echo "Running gitleaks on staged changes..."
gitleaks protect --staged --config .gitleaks.toml --redact

