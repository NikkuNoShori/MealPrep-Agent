# Test-mode environment variables.
#
# Vitest defaults to mode='test' and loads this file early in startup,
# overriding `.env` and `.env.local`. Values here exist so the supabase
# client constructs URLs that MSW can intercept — they are NOT real
# credentials and do not connect to anything.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=test-anon-key
